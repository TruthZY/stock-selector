kline.db-wal
kline.db-shm
kline.db.*.bak
user_pool.json
*.log

# 回测报告输出与临时验证截图
reports/
_verify_*.png

# 后台下载的失败清单（每次运行重写）
download_failed.txt

# 回测缓存快照（体积大，走 GitHub Release 附件分发，不入库）
kline_cache_*.db.gz
kline_cache_*.db

# 推送系统密钥与运行时状态（密钥永不入库；只保留 *.example 样例）
.env
push.env
deploy/push.env
push/state/
push/logs/
!*.env.example

