# 股票推送系统环境变量样例
# 用法：复制为 deploy/push.env（或项目根 .env），填入真实值，并 chmod 600。
# 该文件只放占位符，真实密钥永不入 git（.gitignore 已忽略 push.env / .env）。
# systemd 用 EnvironmentFile= 指向它；docker compose 用 env_file 加载它。

# --- 推送渠道 ---
PUSH_CHANNEL=dingtalk

# 钉钉群机器人（安全设置选「加签」）：webhook 完整 URL + SEC 开头的加签密钥
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME
DINGTALK_SECRET=SECREPLACE_ME
# 可选：若机器人同时设了「自定义关键词」，填这里，消息会自动带上
DINGTALK_KEYWORD=

# 预留：通用 webhook 渠道（PUSH_CHANNEL=webhook 时生效）
WEBHOOK_URL=
WEBHOOK_TOKEN=

# --- 推送行为 ---
PUSH_MAX_RETRIES=3
PUSH_RETRY_BACKOFF=2.0
PUSH_HTTP_TIMEOUT=8.0

# --- 作业A：盘中扫描（14:00）---
PUSH_SCAN_BUDGET_SEC=120
PUSH_GATHER_CONCURRENCY=10
PUSH_MIN_COVERAGE=0.6
# 覆盖日K触发时刻/战法（逗号分隔多个时刻）：
#PUSH_DAILY_TIMES=14:00
#PUSH_DAILY_RULE=accumulation_detect
# 中轨角度过滤：布林中轨角度 < 该值(度)则剔除；0=剔除中轨向下的票（越大越严）
#PUSH_DAILY_MIN_MID_ANGLE=0
# 前10排序的质量分权重：quality = ANGLE_W*中轨角度 + VOL_W*(量比-1)，均越高越靠前
#PUSH_RANK_ANGLE_W=1.0
#PUSH_RANK_VOL_W=10.0

# --- 作业B：盘后更新 ---
PUSH_POSTCLOSE_FIRST=15:40
PUSH_POSTCLOSE_RETRIES=16:40,18:00,20:00

# --- 作业C：盘后扫描推送（只用收盘缓存数据，不碰实时快照；须排在作业B末次之后）---
PUSH_ENABLE_POSTCLOSE_SCAN=true
PUSH_POSTCLOSE_SCAN_TIME=21:00
# 盘后榜单只取前N只（0=沿用日K的 PUSH_DAILY_TOPN）
PUSH_POSTCLOSE_SCAN_TOPN=0

# --- 命中滑动记录（近N个扫描日的盘前/盘后命中次数，随推送一并告知）---
PUSH_HIT_WINDOW_DAYS=10
PUSH_HIT_KEEP_DATES=40

# --- 周期开关（30m 预留，本期不开）---
#PUSH_ENABLE_30M=false

# --- 日志/状态 ---
PUSH_LOG_LEVEL=INFO
#PUSH_LOG_DIR=/opt/stock-selector/push/logs
#PUSH_STATE_DIR=/opt/stock-selector/push/state
